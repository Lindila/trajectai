PORT=3001
# Origines autorisées (séparées par des virgules) : le front local et, en prod, l'URL Vercel
CORS_ORIGIN=http://localhost:5173

# Assistant IA — n'importe quelle API compatible OpenAI.
# Gratuit : créez une clé sur https://console.groq.com/keys (modèle open source GPT-OSS 120B)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
# Alternative 100 % locale et open source avec Ollama (https://ollama.com) :
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# Sans clé, l'assistant fonctionne quand même avec un moteur de règles local.
